# epistemic — keys for the agent, experiments, and gates.
# Copy to `.env` (gitignored) and fill in what you use. epistemic loads it on start.
#
# NOTE: the agent's own model auth can also be done interactively with /login
# (stored in ~/.pi/agent/auth.json) — that's the recommended path for the chat model.

# ── Agent model providers (default is openrouter/deepseek-v4-pro) ──
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Falsification-review adversary (needs ≥2 providers to cross-check claims) ──
# Used by /skill:falsification-review (src/adversary/dispatch.ts).
OPENAI_API_KEY=
GOOGLE_API_KEY=
# (ANTHROPIC_API_KEY / OPENROUTER_API_KEY above are also used as adversaries)

# ── HuggingFace (baseline reproduction, gated datasets) ──
HF_TOKEN=

# ── Modal (compute target: modal — serverless GPU experiment execution) ──
# Easiest: run `modal setup` once (stores ~/.modal.toml). Or set these:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
