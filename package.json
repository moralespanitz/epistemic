{
  "name": "epistemic",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "A research-discipline coding agent: pre-register hypotheses, reproduce baselines, run experiments, falsify claims, and ship or kill — with an interactive experiment monitor and methodology gates.",
  "keywords": [
    "epistemic",
    "coding-agent",
    "research",
    "methodology",
    "reproducibility",
    "tui",
    "experiments"
  ],
  "license": "MIT",
  "bin": {
    "epistemic": "./bin/epistemic.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "hooks",
    ".claude-plugin",
    ".codex-plugin",
    ".pi",
    "README.md",
    "GUIDE.md",
    "TESTING.md"
  ],
  "scripts": {
    "start": "node bin/epistemic.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find test -name '*.test.ts' ! -name 'tui-drive.test.ts' -print)",
    "test:tui:pipe": "tsx --test test/tui-drive.test.ts",
    "test:tui": "bash test/tui-e2e.sh",
    "test:agent-tui": "bash test/agent-tui-validate.sh",
    "test:agent-tui:ux": "bash test/agent-tui-ux.sh",
    "test:snapshot": "bash test/agent-tui-snapshot.sh",
    "test:claude-skills": "bash tests/claude-code/run-skill-tests.sh",
    "test:integration:hook": "node tests/integration/hook-session-start.test.mjs",
    "test:integration:graph": "npx tsx --test tests/integration/graph-server.integration.test.ts",
    "test:integration:tui": "bash tests/integration/agent-tui-epistemic.sh",
    "test:integration": "npm run test:integration:hook && npm run test:integration:graph",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "cytoscape": "^3.34.0",
    "d3": "^7.9.0",
    "tsx": "^4.22.4"
  },
  "pi": {
    "extensions": [
      "./packages/omp/src/commands/epistemic.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes/epistemic.json"
    ]
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "typescript": "^6.0.3"
  }
}
